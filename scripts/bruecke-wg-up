#!/bin/sh
set -eu

if [ "$#" -ne 4 ] && [ "$#" -ne 5 ] && [ "$#" -ne 6 ] && [ "$#" -ne 7 ]; then
	echo "usage: bruecke-wg-up <interface> <address-cidrs> <listen-port> <private-key-file> [outbound-interface] [client-ipv4-cidr] [client-ipv6-cidr]" >&2
	exit 2
fi

interface="$1"
address_cidrs="$2"
listen_port="$3"
private_key_file="$4"
outbound_interface="${5:-}"
client_ipv4_cidr="${6:-}"
client_ipv6_cidr="${7:-}"

detect_outbound_interface() (
	# Route output is a word list, not a filename pattern.
	set -f
	# Deliberately split route fields into arguments.
	# shellcheck disable=SC2046
	set -- $(ip -4 route show default 2>/dev/null || true)
	while [ "$#" -gt 0 ]; do
		if [ "$1" = "dev" ]; then
			shift
			if [ "$#" -gt 0 ]; then
				printf '%s\n' "$1"
				return 0
			fi
		fi
		shift
	done
	return 1
)

enable_forwarding() (
	version="$1"
	setting="$2"
	setting_file="$3"
	if [ "$(cat "$setting_file" 2>/dev/null || true)" = "1" ]; then
		return
	fi
	if command -v sysctl >/dev/null 2>&1; then
		sysctl -w "$setting=1" >/dev/null || true
	else
		printf '1\n' >"$setting_file" || true
	fi
	if [ "$(cat "$setting_file" 2>/dev/null || true)" != "1" ]; then
		printf '%s forwarding is disabled; set --sysctl %s=1\n' "$version" "$setting" >&2
		exit 1
	fi
)

add_gateway_rules() (
	firewall="$1"
	# Split the comma-delimited CIDRs without glob expansion; IFS stays local.
	IFS=,
	set -f
	for cidr in $2; do
		[ -n "$cidr" ] || continue
		"$firewall" -t nat -C POSTROUTING -s "$cidr" -o "$outbound_interface" -j MASQUERADE 2>/dev/null \
			|| "$firewall" -t nat -A POSTROUTING -s "$cidr" -o "$outbound_interface" -j MASQUERADE
	done
	"$firewall" -C FORWARD -i "$interface" -o "$outbound_interface" -j ACCEPT 2>/dev/null \
		|| "$firewall" -A FORWARD -i "$interface" -o "$outbound_interface" -j ACCEPT
	"$firewall" -C FORWARD -i "$outbound_interface" -o "$interface" \
		-m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT 2>/dev/null \
		|| "$firewall" -A FORWARD -i "$outbound_interface" -o "$interface" \
			-m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT
)

setup_gateway() {
	if [ "$outbound_interface" = "auto" ]; then
		outbound_interface=$(detect_outbound_interface || true)
	fi
	if [ -z "$outbound_interface" ]; then
		echo "could not detect outbound interface" >&2
		exit 1
	fi
	if ! command -v iptables >/dev/null 2>&1; then
		echo "iptables is required for WireGuard internet gateway mode" >&2
		exit 1
	fi
	if [ -n "$client_ipv4_cidr" ] && [ "$client_ipv4_cidr" != "-" ]; then
		enable_forwarding IPv4 net.ipv4.ip_forward /proc/sys/net/ipv4/ip_forward
		add_gateway_rules iptables "$client_ipv4_cidr"
	fi
	if [ -n "$client_ipv6_cidr" ] && [ "$client_ipv6_cidr" != "-" ]; then
		if ! command -v ip6tables >/dev/null 2>&1; then
			echo "ip6tables is required for WireGuard IPv6 gateway mode" >&2
			exit 1
		fi
		enable_forwarding IPv6 net.ipv6.conf.all.forwarding /proc/sys/net/ipv6/conf/all/forwarding
		add_gateway_rules ip6tables "$client_ipv6_cidr"
	fi
}

if ! ip link show dev "$interface" >/dev/null 2>&1; then
	ip link add dev "$interface" type wireguard
fi

wg set "$interface" private-key "$private_key_file" listen-port "$listen_port"
# Keep list splitting local instead of changing IFS for the rest of the script.
(
	IFS=,
	set -f
	for address_cidr in $address_cidrs; do
		if [ -n "$address_cidr" ]; then
			ip address replace "$address_cidr" dev "$interface"
		fi
	done
)
ip link set up dev "$interface"

case "$outbound_interface" in
	""|"-"|"none") ;;
	*) setup_gateway ;;
esac
