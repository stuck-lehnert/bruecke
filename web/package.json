{
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test --test-concurrency=1 src/*.test.mjs",
    "lint": "eslint src vite.config.js eslint.config.js",
    "format": "prettier --write src index.html vite.config.js eslint.config.js package.json .prettierrc.json",
    "format:check": "prettier --check src index.html vite.config.js eslint.config.js package.json .prettierrc.json",
    "check": "npm run format:check && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@heroui/react": "^3.2.6",
    "@heroui/styles": "^3.2.6",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "tailwindcss": "^4.3.3",
    "vite": "latest"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "eslint": "9.39.1",
    "eslint-plugin-react": "7.37.5",
    "globals": "16.5.0",
    "prettier": "3.6.2"
  }
}
